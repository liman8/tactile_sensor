      <geom name="fork_3wide_tip1" type="box" pos="0.015500 0.000000 0.000900" size="0.002500 0.000910 0.000900"/>
      <geom name="fork_3wide_tip2" type="box" pos="0.015500 0.006600 0.000900" size="0.002500 0.000910 0.000900"/>
      <geom name="fork_3wide_palm" type="box" pos="-0.021500 0 0.000900" size="0.005500 0.008000 0.000900"/>
      <geom name="fork_3wide_neck" type="box" pos="-0.035693 0 0.003229" size="0.009 0.0035 0.000900" euler="0 15 0"/>
      <geom name="fork_3wide_bend" type="cylinder" pos="-0.044386 0 0.005558" size="0.0013 0.0055" euler="90 0 0"/>
      <geom name="fork_3wide_handle" type="box" pos="-0.094341 0 0.003429" size="0.05 0.0055 0.0013" euler="0 -2.4413 0"/>
    </body>

    <!-- ===== FORK: plastic fork, 4 thick tines curving 4 deg (held out from training) - face down:
         rests on its tine tips and its handle; neck shortened to end on the table, handle flat ===== -->
    <body name="fork_plastic" pos="0 0 0.004490" quat="0 1 0 0" childclass="tool">
      <site name="fork_plastic_face" pos="0 0 0" size="0.001" group="4"/>  <!-- old tool frame -->
      <geom name="fork_plastic_tine0" type="box" pos="0.004963 -0.0087 0.002246" size="0.015 0.0015 0.0012" euler="0 -4 0" density="1050" material="plastic_white"/>
