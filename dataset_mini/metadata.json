{
 "description": "GelSight tactile dataset of fork_stl (ForkMilimeter.stl), moving sensor; see README.md",
 "conventions": {
  "units": "SI (m, N, s, rad) unless a name ends in _mm or _deg; depth maps in mm; images uint8 RGB",
  "quaternion": "(w, x, y, z), unit, rotates vectors from the child frame into the parent frame",
  "rpy": "(roll, pitch, yaw) in rad with R = Rz(yaw) @ Ry(pitch) @ Rx(roll) (intrinsic Z-Y'-X'')",
  "pose_X_in_Y": "p_Y = R @ p_X + t, t = origin of X in Y, R = axes of X in Y (columns)",
  "world_frame": "W: table top is z = 0, +z up",
  "fork_frame": "F: body fork_stl = the STL file's own frame scaled to metres; +x towards the tine tips, +z = side the tines curve towards, origin = STL origin (neck/palm junction)",
  "sensor_frame": "S: origin at the centre of the undeformed gel contact face; +x = image column, +y = image row, +z = viewing direction, out of the gel into the object (world down for an untilted sensor). Right-handed.",
  "pixel_to_sensor": "x_mm = (col - (W-1)/2) * mm_per_px, y_mm = (row - (H-1)/2) * mm_per_px; pixel (col, row) shows the point (x, y) of the gel face, the camera is orthographic along +z_S",
  "fork_centre": "bbox: centre of the fork mesh's axis-aligned bounding box in F; com: centre of mass",
  "gel_contacts": "normal_s: unit vector from the fork/table into the gel (= direction of the normal force on the gel), in S; force_s: total force the fork/table exerts on the gel, in S; fn = normal, ft = tangential (2 components in MuJoCo's contact frame)",
  "table_contacts": "fork-table contacts of the FREE-fork run at the end of the press (the welded fork has none): normal_w from the table into the fork, in W",
  "marker_field": "marker_rest (N, 2) and marker_shift (N, 2) in pixels (col, row); drawn at rest + shift",
  "parts": "by fork-frame x: tines >= 7.0 mm > palm >= 1.0 > neck >= -15.0 > handle; 'edge' = surface whose normal is within 60 deg of the fork plane (side walls, rim)"
 },
 "units_note": "see conventions",
